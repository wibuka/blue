import "core/libc"
import "vendor/luci"

using begin     LUCI_begin_drawing
using end       LUCI_end_drawing
using Texture   LUCI_Texture
using Rectangle LUCI_Rectangle

const center_x: f32 = 178.0
const center_y: f32 = 130.0

const WAVE_AMPLITUDE: f32 = 2.0
const WAVE_SPEED:     f32 = 2.5
const WAVE_WAIT_MIN:  f32 = 0.6
const WAVE_WAIT_MAX:  f32 = 1.8

struct WaveMotion {
    x: f32
    y: f32
    target_x: f32
    target_y: f32
    timer: f32
    interval: f32
}

var angle_s: f32
var angle_m: f32
var angle_h: f32

var watch_hand_texture: Texture
var watch_lib_texture: Texture
var watch_texture: Texture
var background: Texture

var motion: [4]WaveMotion
var previous_time: f64

const SH_RECT = Rectangle{0, 0, 26, 5}
const MH_RECT = Rectangle{0, 6, 26, 14}
const HH_RECT = Rectangle{0, 21, 26, 6}

def get_time() -> f64 {
    var ts: timespec
    clock_gettime(CLOCK_MONOTONIC, &ts)
    return ts.tv_sec as f64 + ts.tv_nsec as f64 / 1000000000.0
}

def random_range(min: f32, max: f32) -> f32 {
    return min + (rand() % 1000) as f32 / 1000.0 * (max - min)
}

def choose_wave_target(index: i32) {
    motion[index].target_x = random_range(-WAVE_AMPLITUDE, WAVE_AMPLITUDE)
    motion[index].target_y = random_range(-WAVE_AMPLITUDE, WAVE_AMPLITUDE)
    motion[index].interval = random_range(WAVE_WAIT_MIN, WAVE_WAIT_MAX)
    motion[index].timer = 0.0
}

def update_wave(index: i32, dt: f32) {
    motion[index].timer += dt

    if motion[index].timer >= motion[index].interval {
        choose_wave_target(index)
    }

    var factor = WAVE_SPEED * dt

    if factor > 1.0 {
        factor = 1.0
    }

    motion[index].x += (motion[index].target_x - motion[index].x) * factor
    motion[index].y += (motion[index].target_y - motion[index].y) * factor
}

def update_animation(dt: f32) {
    for i in 0..4 {
        update_wave(i, dt)
    }
}

def draw() {
    LUCI_draw_texture_ex(
        background,
        Rectangle{
            0,
            0,
            background.width as f32 * 2,
            background.height as f32 * 2
        },
        Rectangle{
            -16,
            -12,
            background.width as f32 * 4,
            background.height as f32 * 4
        },
        0,
        0,
        0,
        LUCI_COLOR_WHITE
    )

    LUCI_draw_texture_ex(
        watch_texture,
        Rectangle{
            0,
            0,
            watch_texture.width as f32,
            watch_texture.height as f32
        },
        Rectangle{
            -16 + motion[3].x,
            motion[3].y,
            watch_texture.width as f32 * 2,
            watch_texture.height as f32 * 2
        },
        0,
        0,
        0,
        LUCI_COLOR_WHITE
    )

    LUCI_draw_texture_ex(
        watch_hand_texture,
        MH_RECT,
        Rectangle{
            center_x + motion[3].x + motion[1].x,
            center_y + motion[3].y + motion[1].y,
            MH_RECT.width * 2,
            MH_RECT.height * 2
        },
        0,
        12,
        angle_m * 3.14159265 / 180.0,
        LUCI_COLOR_WHITE
    )

    LUCI_draw_texture_ex(
        watch_hand_texture,
        HH_RECT,
        Rectangle{
            center_x + motion[3].x + motion[2].x,
            center_y + motion[3].y + motion[2].y,
            HH_RECT.width * 2,
            HH_RECT.height * 2
        },
        0,
        4,
        angle_h * 3.14159265 / 180.0,
        LUCI_COLOR_WHITE
    )

    LUCI_draw_texture_ex(
        watch_hand_texture,
        SH_RECT,
        Rectangle{
            center_x + motion[3].x + motion[0].x,
            center_y + motion[3].y + motion[0].y,
            SH_RECT.width * 2,
            SH_RECT.height * 2
        },
        0,
        4,
        angle_s * 3.14159265 / 180.0,
        LUCI_COLOR_WHITE
    )

    LUCI_draw_texture_ex(
        watch_lib_texture,
        Rectangle{
            0,
            0,
            watch_lib_texture.width as f32,
            watch_lib_texture.height as f32
        },
        Rectangle{
            center_x + motion[3].x,
            center_y + motion[3].y,
            watch_lib_texture.width as f32 * 2,
            watch_lib_texture.height as f32 * 2
        },
        8,
        6,
        0,
        LUCI_COLOR_WHITE
    )
}

def main() {
    LUCI_init()
    LUCI_window_resize(320, 260)
    LUCI_window_resizable(false)

    watch_texture = LUCI_load_texture("asset/watch.png")
    watch_hand_texture = LUCI_load_texture("asset/watch_hand.png")
    watch_lib_texture = LUCI_load_texture("asset/watch_lib.png")
    background = LUCI_load_texture("asset/background.png")

    srand((get_time() * 1000000.0) as u32)

    for i in 0..4 {
        choose_wave_target(i)
    }

    previous_time = get_time()

    loop {
        var current_time = get_time()
        var delta_time = (current_time - previous_time) as f32
        previous_time = current_time

        if delta_time > 0.05 {
            delta_time = 0.05
        }

        update_animation(delta_time)

        var now = time(nil)
        var t = localtime(&now)

        var s = t.tm_sec
        var m = t.tm_min
        var h = t.tm_hour

        angle_s = s as f32 * 6.0 - 90.0
        angle_m = m as f32 * 6.0 + s as f32 * 0.1 - 90.0
        angle_h = (h % 12) as f32 * 30.0 + m as f32 * 0.5 - 90.0

        if LUCI_window_should_close() {
            break
        }

        begin()
        draw()
        end()
    }
}
