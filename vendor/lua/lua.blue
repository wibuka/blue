@inline
def lua_pcall(L: *lua_State, nargs: i32, nresults: i32, errfunc: i32) -> i32 {
    return lua_pcallk(L, nargs, nresults, errfunc, 0, nil)
}
@inline
def lua_call(L: *lua_State, nargs: i32, nresults: i32) -> u0 {
    return lua_callk(L, nargs, nresults, 0, nil)
}

