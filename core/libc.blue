// math.h — Mathematical Functions (symbols live in libm: see header)
// Classification macros isfinite/signbit/fpclassify have no symbols and
// are omitted; isnan/isinf below ARE real (weak) libc symbols. The M_*
// constants below are plain doubles, safe as `const` bindings.

// Trigonometric & Hyperbolic
