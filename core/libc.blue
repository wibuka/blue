def calloc(nmemb: usize, size: usize) -> *u0 // Zero-initialized
def realloc(ptr: *u0, size: usize) -> *u0
def free(ptr: *u0)
def aligned_alloc(alignment: usize, size: usize) -> *u0 // C11
def posix_memalign(memptr: **u0, alignment: usize, size: usize) -> i32 // POSIX

