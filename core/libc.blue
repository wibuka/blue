def readdir(dir: *DIR) -> *dirent
def closedir(dir: *DIR) -> i32
def rewinddir(dir: *DIR)
def seekdir(dir: *DIR, loc: i64)
def telldir(dir: *DIR) -> i64
def dirfd(dir: *DIR) -> i32

const DT_UNKNOWN = 0
const DT_FIFO = 1
const DT_CHR = 2
const DT_DIR = 4
const DT_BLK = 6
const DT_REG = 8
const DT_LNK = 10
const DT_SOCK = 12

// sys/stat.h — File Status (Linux x86_64 layout, flattened)
// NOTE: Blue keeps types and functions in one namespace, so the C struct
// `stat`/`sigaction`/`div_t` family is spelled `Stat`/`Sigaction`/
// `Div`/`Ldiv`/`Lldiv`/`Imaxdiv` while the functions keep C names.
struct Stat {
    dev: u64
    ino: u64
    nlink: u64
    mode: u32
    uid: u32
    gid: u32
    pad0: i32
    rdev: u64
    size: i64
    blksize: i64
    blocks: i64
    atime_sec: i64
    atime_nsec: i64
    mtime_sec: i64
    mtime_nsec: i64
    ctime_sec: i64
    ctime_nsec: i64
    unused: [3]i64
}
def stat(path: *u8, buf: *Stat) -> i32
def fstat(fd: i32, buf: *Stat) -> i32
def lstat(path: *u8, buf: *Stat) -> i32
def fstatat(dirfd: i32, path: *u8, buf: *Stat, flags: i32) -> i32
def mkdir(path: *u8, mode: u32) -> i32
def mkfifo(path: *u8, mode: u32) -> i32
def mknod(path: *u8, mode: u32, dev: u64) -> i32
def chmod(path: *u8, mode: u32) -> i32
def fchmod(fd: i32, mode: u32) -> i32
def umask(mask: u32) -> u32
// NOTE: S_ISREG/S_ISDIR/... are bitmask macros; Blue has no bitwise
// operators, so compare (mode & S_IFMT) idioms are unavailable. The raw
// S_IFMT file-type and permission constants are declared.
const S_IFMT = 61440
const S_IFSOCK = 49152
const S_IFLNK = 40960
const S_IFREG = 32768
const S_IFBLK = 24576
const S_IFDIR = 16384
const S_IFCHR = 8192
const S_IFIFO = 4096
const S_ISUID = 2048
const S_ISGID = 1024
const S_ISVTX = 512
const S_IRUSR = 256
const S_IWUSR = 128
const S_IXUSR = 64
const S_IRGRP = 32
const S_IWGRP = 16
const S_IXGRP = 8
const S_IROTH = 4
const S_IWOTH = 2
const S_IXOTH = 1

// sys/mman.h — Memory Mapping (values: Linux x86_64)
// NOTE: MAP_FAILED is (void *)-1. Spell the check as
// `(ptr as i64) == -1`; no `const` can carry a pointer value here.
def mmap(addr: *u0, len: usize, prot: i32, flags: i32, fd: i32, offset: i64) -> *u0
def munmap(addr: *u0, len: usize) -> i32
def mprotect(addr: *u0, len: usize, prot: i32) -> i32
def msync(addr: *u0, len: usize, flags: i32) -> i32
def madvise(addr: *u0, len: usize, advice: i32) -> i32
def mlock(addr: *u0, len: usize) -> i32
def munlock(addr: *u0, len: usize) -> i32

const PROT_NONE = 0
const PROT_READ = 1
const PROT_WRITE = 2
const PROT_EXEC = 4
const MAP_SHARED = 1
const MAP_PRIVATE = 2
const MAP_FIXED = 16
const MAP_ANONYMOUS = 32
const MS_ASYNC = 1
const MS_SYNC = 4
const MS_INVALIDATE = 2
const MADV_NORMAL = 0
const MADV_DONTNEED = 4

// sys/time.h — Time from the System Clock
def gettimeofday(tp: *timeval, tzp: *u0) -> i32 // tzp obsolete: pass nil
struct itimerval {
    interval_sec: i64
    interval_usec: i64
    value_sec: i64
    value_usec: i64
}
def getitimer(which: i32, curr: *itimerval) -> i32
def setitimer(which: i32, newval: *itimerval, oldval: *itimerval) -> i32
const ITIMER_REAL = 0
const ITIMER_VIRTUAL = 1
const ITIMER_PROF = 2

// sys/wait.h — Wait for Child Processes
def wait(status: *i32) -> i32
def waitpid(pid: i32, status: *i32, options: i32) -> i32
// NOTE: WIFEXITED/WEXITSTATUS/... are bit-manipulation macros and cannot
// be expressed (no bitwise operators). Raw option/status constants:
const WNOHANG = 1
const WUNTRACED = 2
const WCONTINUED = 8

// poll.h — Synchronous I/O Multiplexing
struct pollfd {
    fd: i32
    events: i16
    revents: i16
}
def poll(fds: *pollfd, nfds: u64, timeout: i32) -> i32
const POLLIN = 1
const POLLPRI = 2
const POLLOUT = 4
const POLLERR = 8
const POLLHUP = 16
const POLLNVAL = 32
const POLLRDHUP = 8192

// sys/select.h — More I/O Multiplexing
// fd_set is a 1024-bit mask; FD_SET/FD_ISSET/... are bit macros without
// symbols, so selection sets cannot be built from Blue today. The call
// itself is declared for completeness.
struct fd_set {
    bits: [16]u64
}
struct sigset_t {
    val: [16]u64
}
def select(nfds: i32, readfds: *fd_set, writefds: *fd_set, exceptfds: *fd_set, timeout: *timeval) -> i32
def pselect(nfds: i32, readfds: *fd_set, writefds: *fd_set, exceptfds: *fd_set, timeout: *timespec, sigmask: *sigset_t) -> i32

// signal.h — POSIX Signal Extensions
def kill(pid: i32, sig: i32) -> i32
def sigaction(sig: i32, act: *Sigaction, oldact: *Sigaction) -> i32
struct Sigaction {
    handler: sighandler_t
    mask: [16]u64
    flags: i32
    restorer: *u0
}
def sigemptyset(set: *sigset_t) -> i32
def sigfillset(set: *sigset_t) -> i32
def sigaddset(set: *sigset_t, signo: i32) -> i32
def sigdelset(set: *sigset_t, signo: i32) -> i32
def sigismember(set: *sigset_t, signo: i32) -> i32
def sigprocmask(how: i32, set: *sigset_t, oldset: *sigset_t) -> i32
def sigpending(set: *sigset_t) -> i32
def sigsuspend(mask: *sigset_t) -> i32
def psignal(sig: i32, s: *u8)
const SIG_BLOCK = 0
const SIG_UNBLOCK = 1
const SIG_SETMASK = 2
const SA_NOCLDSTOP = 1
const SA_NOCLDWAIT = 2
const SA_SIGINFO = 4
const SA_ONSTACK = 134217728
const SA_RESTART = 268435456
const SA_NODEFER = 1073741824
const SA_RESETHAND = 2147483648

// sched.h — Execution Scheduling
struct sched_param {
    priority: i32
}
def sched_yield() -> i32
def sched_get_priority_max(policy: i32) -> i32
def sched_get_priority_min(policy: i32) -> i32
def sched_getscheduler(pid: i32) -> i32
def sched_setscheduler(pid: i32, policy: i32, param: *sched_param) -> i32
def sched_getparam(pid: i32, param: *sched_param) -> i32
def sched_setparam(pid: i32, param: *sched_param) -> i32
const SCHED_OTHER = 0
const SCHED_FIFO = 1
const SCHED_RR = 2

// pthread.h — Threads (opaque where the layout is arch-private)
// Static initializers (PTHREAD_MUTEX_INITIALIZER, ...) are C macros over
// those private layouts: always initialise with pthread_*_init instead.
using pthread_t u64
using pthread_key_t u32
using pthread_once_t i32
using pthread_spinlock_t i32
// Opaque in C, but fixed-size on Linux x86_64, so spelled as raw storage:
// stack allocation (`var m: pthread_mutex_t`) works, field access is
// meaningless by design.
struct pthread_attr_t {
    raw: [56]u8
}
struct pthread_mutex_t {
    raw: [40]u8
}
struct pthread_mutexattr_t {
    raw: [4]u8
}
struct pthread_cond_t {
    raw: [48]u8
}
struct pthread_condattr_t {
    raw: [4]u8
}
struct pthread_rwlock_t {
    raw: [56]u8
}
struct pthread_rwlockattr_t {
    raw: [8]u8
}
def pthread_create(thread: *pthread_t, attr: *pthread_attr_t, start: (*u0) -> *u0, arg: *u0) -> i32
def pthread_join(thread: pthread_t, retval: **u0) -> i32
def pthread_detach(thread: pthread_t) -> i32
def pthread_exit(retval: *u0) -> u0
def pthread_self() -> pthread_t
def pthread_equal(t1: pthread_t, t2: pthread_t) -> i32
def pthread_cancel(thread: pthread_t) -> i32
def pthread_once(control: *pthread_once_t, init: () -> u0) -> i32
def pthread_key_create(key: *pthread_key_t, destructor: (*u0) -> u0) -> i32
def pthread_key_delete(key: pthread_key_t) -> i32
def pthread_setspecific(key: pthread_key_t, value: *u0) -> i32
def pthread_getspecific(key: pthread_key_t) -> *u0
def pthread_mutex_init(mutex: *pthread_mutex_t, attr: *pthread_mutexattr_t) -> i32
def pthread_mutex_destroy(mutex: *pthread_mutex_t) -> i32
def pthread_mutex_lock(mutex: *pthread_mutex_t) -> i32
def pthread_mutex_trylock(mutex: *pthread_mutex_t) -> i32
def pthread_mutex_unlock(mutex: *pthread_mutex_t) -> i32
def pthread_cond_init(cond: *pthread_cond_t, attr: *pthread_condattr_t) -> i32
def pthread_cond_destroy(cond: *pthread_cond_t) -> i32
def pthread_cond_wait(cond: *pthread_cond_t, mutex: *pthread_mutex_t) -> i32
def pthread_cond_signal(cond: *pthread_cond_t) -> i32
def pthread_cond_broadcast(cond: *pthread_cond_t) -> i32
def pthread_rwlock_init(lock: *pthread_rwlock_t, attr: *pthread_rwlockattr_t) -> i32
def pthread_rwlock_destroy(lock: *pthread_rwlock_t) -> i32
def pthread_rwlock_rdlock(lock: *pthread_rwlock_t) -> i32
def pthread_rwlock_wrlock(lock: *pthread_rwlock_t) -> i32
def pthread_rwlock_unlock(lock: *pthread_rwlock_t) -> i32
def pthread_spin_init(lock: *pthread_spinlock_t, pshared: i32) -> i32
def pthread_spin_destroy(lock: *pthread_spinlock_t) -> i32
def pthread_spin_lock(lock: *pthread_spinlock_t) -> i32
def pthread_spin_trylock(lock: *pthread_spinlock_t) -> i32
def pthread_spin_unlock(lock: *pthread_spinlock_t) -> i32
const PTHREAD_ONCE_INIT = 0

// semaphore.h — Counting Semaphores (opaque in C, 32 bytes on Linux)
struct sem_t {
    raw: [32]u8
}
def sem_init(sem: *sem_t, pshared: i32, value: u32) -> i32
def sem_destroy(sem: *sem_t) -> i32
def sem_wait(sem: *sem_t) -> i32
def sem_trywait(sem: *sem_t) -> i32
def sem_post(sem: *sem_t) -> i32
def sem_getvalue(sem: *sem_t, sval: *i32) -> i32

// sys/socket.h + netinet/in.h + netdb.h — Sockets (Linux values)
struct sockaddr {
    family: u16
    data: [14]u8
}
struct in_addr {
    addr: u32
}
struct sockaddr_in {
    family: u16
    port: u16
    addr: u32
    zero: [8]u8
}
struct sockaddr_in6 {
    family: u16
    port: u16
    flowinfo: u32
    addr: [16]u8
    scope_id: u32
}
struct addrinfo {
    flags: i32
    family: i32
    socktype: i32
    protocol: i32
    addrlen: u32
    addr: *sockaddr
    canonname: *u8
    next: *u0 // *addrinfo; spelled *u0, cast back with `as`
}
def socket(domain: i32, stype: i32, protocol: i32) -> i32
def bind(sockfd: i32, addr: *sockaddr, addrlen: u32) -> i32
def connect(sockfd: i32, addr: *sockaddr, addrlen: u32) -> i32
def listen(sockfd: i32, backlog: i32) -> i32
def accept(sockfd: i32, addr: *sockaddr, addrlen: *u32) -> i32
def getsockname(sockfd: i32, addr: *sockaddr, addrlen: *u32) -> i32
def getpeername(sockfd: i32, addr: *sockaddr, addrlen: *u32) -> i32
def send(sockfd: i32, buf: *u0, len: usize, flags: i32) -> i64
def recv(sockfd: i32, buf: *u0, len: usize, flags: i32) -> i64
def sendto(sockfd: i32, buf: *u0, len: usize, flags: i32, dest: *sockaddr, addrlen: u32) -> i64
def recvfrom(sockfd: i32, buf: *u0, len: usize, flags: i32, src: *sockaddr, addrlen: *u32) -> i64
def setsockopt(sockfd: i32, level: i32, optname: i32, optval: *u0, optlen: u32) -> i32
def getsockopt(sockfd: i32, level: i32, optname: i32, optval: *u0, optlen: *u32) -> i32
def shutdown(sockfd: i32, how: i32) -> i32
def socketpair(domain: i32, stype: i32, protocol: i32, sv: *i32) -> i32
def getaddrinfo(node: *u8, service: *u8, hints: *addrinfo, res: **addrinfo) -> i32
def freeaddrinfo(res: *addrinfo)
def gai_strerror(errcode: i32) -> *u8
def htons(hostshort: u16) -> u16
def htonl(hostlong: u32) -> u32
def ntohs(netshort: u16) -> u16
def ntohl(netlong: u32) -> u32
def inet_pton(af: i32, src: *u8, dst: *u0) -> i32
def inet_ntop(af: i32, src: *u0, dst: *u8, size: u32) -> *u8

const AF_UNSPEC = 0
