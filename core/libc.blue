// stdlib.h — General Utilities

// Program Termination
def abort() -> u0
def exit(status: i32) -> u0
def _Exit(status: i32) -> u0
def atexit(function: () -> u0) -> i32
def at_quick_exit(function: () -> u0) -> i32 // C11
def quick_exit(status: i32) -> u0            // C11

// Environment & Execution
def getenv(name: *u8) -> *u8
def system(command: *u8) -> i32
// POSIX environment (environ itself is a global: omitted, see header)
def setenv(name: *u8, value: *u8, overwrite: i32) -> i32
def unsetenv(name: *u8) -> i32
def putenv(string: *u8) -> i32
def clearenv() -> i32

// Memory Allocation
def malloc(size: usize) -> *u0
def calloc(nmemb: usize, size: usize) -> *u0 // Zero-initialized
def realloc(ptr: *u0, size: usize) -> *u0
def free(ptr: *u0)
def aligned_alloc(alignment: usize, size: usize) -> *u0 // C11
def posix_memalign(memptr: **u0, alignment: usize, size: usize) -> i32 // POSIX

// Integer Conversions & Absolute Values
def atof(str: *u8) -> f64
def atoi(str: *u8) -> i32
def atol(str: *u8) -> i64
def atoll(str: *u8) -> i64

def abs(x: i32) -> i32
def labs(x: i64) -> i64
def llabs(x: i64) -> i64

// Division Results
struct Div {
    quot: i32
    rem: i32
}
struct Ldiv {
    quot: i64
    rem: i64
}
struct Lldiv {
    quot: i64
    rem: i64
}
def div(numer: i32, denom: i32) -> Div
def ldiv(numer: i64, denom: i64) -> Ldiv
def lldiv(numer: i64, denom: i64) -> Lldiv

// String-to-Integer Conversions
def strtol(str: *u8, endptr: **u8, base: i32) -> i64
def strtoul(str: *u8, endptr: **u8, base: i32) -> u64
def strtoll(str: *u8, endptr: **u8, base: i32) -> i64
def strtoull(str: *u8, endptr: **u8, base: i32) -> u64

// Floating-Point Conversions
def strtod(str: *u8, endptr: **u8) -> f64
def strtof(str: *u8, endptr: **u8) -> f32
def wcstod(str: *wchar_t, endptr: **wchar_t) -> f64
def wcstof(str: *wchar_t, endptr: **wchar_t) -> f32
def wcstol(str: *wchar_t, endptr: **wchar_t, base: i32) -> i64
def wcstoul(str: *wchar_t, endptr: **wchar_t, base: i32) -> u64
// NOTE: strtold/wcstold omitted; Blue lacks an ABI-compatible long double type.

// Random Numbers
def rand() -> i32
def srand(seed: u32)
