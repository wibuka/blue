// setjmp.h — Non-Local Jumps
// jmp_buf holds the 8 callee-saved registers on x86_64; plain setjmp
// does not touch the signal mask, so the trailing sigjmp fields live in
// sigjmp_buf only.
struct jmp_buf {
    val: [8]i64
}
struct sigjmp_buf {
    val: [8]i64
    saved: i32
    mask: [16]u64
}
def setjmp(env: *jmp_buf) -> i32
def longjmp(env: *jmp_buf, val: i32) -> u0
def sigsetjmp(env: *sigjmp_buf, savesigs: i32) -> i32
def siglongjmp(env: *sigjmp_buf, val: i32) -> u0

// signal.h — Signal Handling (ISO part; POSIX extensions in Part 2)
// NOTE: SIG_DFL is the null handler: pass nil. SIG_IGN/SIG_ERR are the
// addresses 1 and -1, which Blue cannot currently spell as function
// values; use sigaction with an empty mask instead, or the POSIX helpers.
using sighandler_t (i32) -> u0
def signal(sig: i32, handler: sighandler_t) -> sighandler_t
def raise(sig: i32) -> i32
// Signal numbers (Linux x86_64)
const SIGHUP = 1
const SIGINT = 2
const SIGQUIT = 3
const SIGILL = 4
const SIGTRAP = 5
const SIGABRT = 6
const SIGIOT = 6 // Alias of SIGABRT
const SIGBUS = 7
const SIGFPE = 8
const SIGKILL = 9
const SIGUSR1 = 10
const SIGSEGV = 11
const SIGUSR2 = 12
const SIGPIPE = 13
const SIGALRM = 14
const SIGTERM = 15
const SIGSTKFLT = 16
const SIGCHLD = 17
const SIGCONT = 18
const SIGSTOP = 19
const SIGTSTP = 20
const SIGTTIN = 21
const SIGTTOU = 22
const SIGURG = 23
const SIGXCPU = 24
const SIGXFSZ = 25
const SIGVTALRM = 26
const SIGPROF = 27
const SIGWINCH = 28
const SIGIO = 29
const SIGPOLL = 29 // Alias of SIGIO
const SIGPWR = 30
const SIGSYS = 31
const SIGRTMIN = 32

// stdarg.h — Variable Arguments
