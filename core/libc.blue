def exit(status: i32) -> u0
def _Exit(status: i32) -> u0
def atexit(function: () -> u0) -> i32
def at_quick_exit(function: () -> u0) -> i32 // C11
def quick_exit(status: i32) -> u0            // C11

// Environment & Execution
def getenv(name: *u8) -> *u8
def system(command: *u8) -> i32
// POSIX environment (environ itself is a global: omitted, see header)
def setenv(name: *u8, value: *u8, overwrite: i32) -> i32
def unsetenv(name: *u8) -> i32
def putenv(string: *u8) -> i32
def clearenv() -> i32

// Memory Allocation
