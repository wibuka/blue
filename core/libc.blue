// stdio.h — Standard Input/Output

// Types
struct FILE
struct fpos_t
struct va_list

// File Operations
def remove(filename: *u8) -> i32
def rename(old: *u8, new: *u8) -> i32
def tmpfile() -> *FILE
def tmpnam(str: *u8) -> *u8 // Deprecated: race condition risks

// Opening & Closing
def fopen(filename: *u8, mode: *u8) -> *FILE
def freopen(filename: *u8, mode: *u8, stream: *FILE) -> *FILE
def fclose(stream: *FILE) -> i32
def fflush(stream: *FILE) -> i32
// POSIX opening: file descriptors, pipes, memory streams
def fdopen(fd: i32, mode: *u8) -> *FILE
def popen(command: *u8, mode: *u8) -> *FILE
def pclose(stream: *FILE) -> i32
def fmemopen(buf: *u0, size: usize, mode: *u8) -> *FILE
def open_memstream(bufp: **u8, sizep: *usize) -> *FILE
def fileno(stream: *FILE) -> i32

// Buffering
def setbuf(stream: *FILE, buf: *u8)
def setvbuf(stream: *FILE, buf: *u8, mode: i32, size: usize) -> i32

// Formatted Output
def printf(format: *u8, ...) -> i32
def fprintf(stream: *FILE, format: *u8, ...) -> i32
def sprintf(str: *u8, format: *u8, ...) -> i32
def snprintf(str: *u8, n: usize, format: *u8, ...) -> i32
// POSIX descriptor/va_list output (ap is an opaque *va_list: see header)
def dprintf(fd: i32, format: *u8, ...) -> i32
def vdprintf(fd: i32, format: *u8, ap: *va_list) -> i32
def vprintf(format: *u8, ap: *va_list) -> i32
def vfprintf(stream: *FILE, format: *u8, ap: *va_list) -> i32
def vsprintf(str: *u8, format: *u8, ap: *va_list) -> i32
def vsnprintf(str: *u8, n: usize, format: *u8, ap: *va_list) -> i32

// Formatted Input
def scanf(format: *u8, ...) -> i32
def fscanf(stream: *FILE, format: *u8, ...) -> i32
def sscanf(str: *u8, format: *u8, ...) -> i32
def vscanf(format: *u8, ap: *va_list) -> i32
def vfscanf(stream: *FILE, format: *u8, ap: *va_list) -> i32
def vsscanf(str: *u8, format: *u8, ap: *va_list) -> i32

// Character Input
def fgetc(stream: *FILE) -> i32
def fgets(str: *u8, n: i32, stream: *FILE) -> *u8
def getchar() -> i32
def getc(stream: *FILE) -> i32 // Macro-equivalent to fgetc()
// POSIX line input and unlocked (thread-unsafe, faster) variants
def getline(lineptr: **u8, n: *usize, stream: *FILE) -> i64
def getdelim(lineptr: **u8, n: *usize, delimiter: i32, stream: *FILE) -> i64
def getc_unlocked(stream: *FILE) -> i32
def getchar_unlocked() -> i32
def fgetc_unlocked(stream: *FILE) -> i32
def fgets_unlocked(str: *u8, n: i32, stream: *FILE) -> *u8

// Character Output
def fputc(c: i32, stream: *FILE) -> i32
def fputs(str: *u8, stream: *FILE) -> i32
def putchar(c: i32) -> i32
def putc(c: i32, stream: *FILE) -> i32 // Macro-equivalent to fputc()
def puts(str: *u8) -> i32
def putc_unlocked(c: i32, stream: *FILE) -> i32
def putchar_unlocked(c: i32) -> i32
def fputc_unlocked(c: i32, stream: *FILE) -> i32
def fputs_unlocked(str: *u8, stream: *FILE) -> i32

// Stream Locking (POSIX)
def flockfile(stream: *FILE)
def ftrylockfile(stream: *FILE) -> i32
def funlockfile(stream: *FILE)

// Character Pushback
def ungetc(c: i32, stream: *FILE) -> i32

// Block Input/Output
def fread(ptr: *u0, size: usize, nmemb: usize, stream: *FILE) -> usize
def fwrite(ptr: *u0, size: usize, nmemb: usize, stream: *FILE) -> usize
def fread_unlocked(ptr: *u0, size: usize, nmemb: usize, stream: *FILE) -> usize
def fwrite_unlocked(ptr: *u0, size: usize, nmemb: usize, stream: *FILE) -> usize

// File Positioning
def fgetpos(stream: *FILE, pos: *fpos_t) -> i32
def fseek(stream: *FILE, offset: i64, whence: i32) -> i32
def fsetpos(stream: *FILE, pos: *fpos_t) -> i32
def ftell(stream: *FILE) -> i64
def rewind(stream: *FILE)
def fseeko(stream: *FILE, offset: i64, whence: i32) -> i32
def ftello(stream: *FILE) -> i64

// Stream Status
def clearerr(stream: *FILE)
def feof(stream: *FILE) -> i32
def ferror(stream: *FILE) -> i32
def perror(str: *u8)
def clearerr_unlocked(stream: *FILE)
def feof_unlocked(stream: *FILE) -> i32
def ferror_unlocked(stream: *FILE) -> i32
// NOTE: `gets` was removed from C11 (unsafe): deliberately omitted.
// NOTE: stdin/stdout/stderr are macros over globals: use integer fds
// (STDIN_FILENO et al, see unistd) or fdopen/fileno instead.

// Wide-Character I/O (selected; wide orientation via fwide)
def fwide(stream: *FILE, mode: i32) -> i32
def fwprintf(stream: *FILE, format: *wchar_t, ...) -> i32
def fwscanf(stream: *FILE, format: *wchar_t, ...) -> i32
def swprintf(str: *wchar_t, n: usize, format: *wchar_t, ...) -> i32
def fgetwc(stream: *FILE) -> i32
def fputwc(c: i32, stream: *FILE) -> i32
def getwc(stream: *FILE) -> i32
def putwc(c: i32, stream: *FILE) -> i32
def getwchar() -> i32
def putwchar(c: i32) -> i32
def ungetwc(c: i32, stream: *FILE) -> i32

