// time.h — Time and Date Utilities

// Types
using clock_t u64
using time_t i64 // Platform-dependent in C; i64 assumed for fixed Blue ABI
using clockid_t i32
struct tm {
    tm_sec: i32
    tm_min: i32
    tm_hour: i32
    tm_mday: i32
    tm_mon: i32
    tm_year: i32
    tm_wday: i32
    tm_yday: i32
    tm_isdst: i32
    tm_gmtoff: i64
    tm_zone: *u8
}
struct timespec {
    tv_sec: i64
    tv_nsec: i64
}
struct timeval {
    tv_sec: i64
    tv_usec: i64
}

// Broken-down Time
def asctime(tm: *tm) -> *u8
def ctime(timer: *time_t) -> *u8
def gmtime(timer: *time_t) -> *tm
def localtime(timer: *time_t) -> *tm
def mktime(tm: *tm) -> time_t
// Reentrant (POSIX) variants write into caller-provided storage
def asctime_r(tm: *tm, buf: *u8) -> *u8
def ctime_r(timer: *time_t, buf: *u8) -> *u8
def gmtime_r(timer: *time_t, result: *tm) -> *tm
def localtime_r(timer: *time_t, result: *tm) -> *tm

// Time Formatting
def strftime(str: *u8, max: usize, format: *u8, tm: *tm) -> usize
def strptime(str: *u8, format: *u8, tm: *tm) -> *u8 // POSIX

// Time Values
def time(timer: *time_t) -> time_t
def difftime(time1: time_t, time0: time_t) -> f64
def clock() -> clock_t

// C11 Timespec Functions
def timespec_get(ts: *timespec, base: i32) -> i32
// POSIX high-resolution clocks and sleeping
def clock_gettime(clk: clockid_t, ts: *timespec) -> i32
def clock_getres(clk: clockid_t, ts: *timespec) -> i32
def clock_nanosleep(clk: clockid_t, flags: i32, req: *timespec, rem: *timespec) -> i32
def nanosleep(req: *timespec, rem: *timespec) -> i32
def tzset()
// NOTE: daylight/timezone/tzname are globals: omitted (see header).

